---
import Layout from '../../layouts/Layout.astro';
import Speakers from '../../components/sections/Speakers.astro';
import Oranizers from '../../components/sections/Organizers.astro';
import Sponsors from '../../components/sections/Sponsors.astro';
---

<Layout title="GOLANG MEETUP 2025 — GOPHERS BANGLADESH">
  <div class="bg-gradient-to-b from-gray-900 via-gray-800 to-gray-900 text-gray-200 min-h-screen relative overflow-hidden">
    <!-- Replace the missing gopher pattern with a repeating gradient -->
    <div class="absolute inset-0 bg-gradient-to-r from-gray-800/10 to-gray-900/10 pattern-bg"></div>
    <div class="container-custom px-4 py-6 md:py-12 lg:py-16 mx-auto space-y-8 md:space-y-12 lg:space-y-16 relative opacity-0 translate-y-6" id="main-content">
      <!-- Back to Home Button -->
      <div class="slide-up">
        <a href="/" class="inline-flex items-center gap-2 text-cyan-300 hover:text-teal-300 transition-colors duration-300 group">
          <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          <span class="font-semibold">Back to Home</span>
        </a>
      </div>

      <section class="space-y-6 md:space-y-8 lg:space-y-10 text-center">
        <div class="space-y-4 md:space-y-6 slide-up max-w-6xl mx-auto">
          <div class="flex flex-col md:flex-row justify-center items-center gap-4 md:gap-6">
            <img src="/images/line.png" alt="Golang Logo" class="hidden md:block w-16 h-8 md:w-20 md:h-10 lg:w-24 lg:h-12 object-contain" />
            <img src="/images/Go-Logo_Blue.png" alt="Golang Logo" class="md:hidden w-40 h-26 md:w-24 md:h-16 lg:w-24 lg:h-128 object-contain" />
            <h1 class="font-oswald uppercase font-bold text-3xl md:text-5xl lg:text-7xl xl:text-8xl bg-gradient-to-r from-cyan-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent animate-gradient tracking-wider leading-tight">
              Golang Meetup 2025
            </h1>
          </div>
          
          <div class="flex flex-col md:flex-row items-center justify-center gap-3 md:gap-4 slide-up">
            <span class="text-base md:text-lg lg:text-xl text-gray-400">11<sup>th</sup> January, 2025 | Organized by</span>
            <a href="https://www.facebook.com/groups/8890201047753940" 
               class="flex items-center gap-3 text-cyan-300 hover:text-teal-300 transition-all duration-300">
              <div class="relative">
                <img src="/favicon.png" alt="Gophers Logo" 
                     class="w-10 h-10 md:w-12 md:h-12 object-contain rounded-full shadow-lg group-hover:shadow-teal-500/50 transition-all duration-300 hover:scale-110" />
              </div>
              <span class="text-base md:text-lg lg:text-xl underline decoration-2">Gophers Bangladesh</span>
            </a>
          </div>
        </div>

        <div class="flex flex-col gap-4 md:flex-row md:gap-6 justify-center items-center text-base md:text-lg lg:text-xl slide-up">
          <div class="info-card">
            <span class="text-cyan-400 text-xl md:text-2xl">📅</span>
            <span>11<sup>th</sup> January, 2025</span>
          </div>
          <div class="hidden md:block w-px h-8 bg-gray-700"></div>
          <div class="info-card">
            <span class="text-cyan-400 text-xl md:text-2xl">📍</span>
            <a href="https://maps.app.goo.gl/pCjfaFhHNfPHZZCy7" 
               class="text-cyan-300 hover:text-teal-300 transition-colors duration-300 underline decoration-2">
               The Attention Network
            </a>
          </div>
          <div class="hidden md:block w-px h-8 bg-gray-700"></div>
          <div class="info-card">
            <span class="text-cyan-400 text-xl md:text-2xl">🔗</span>
            <a href="https://www.facebook.com/events/445191745333095" 
               class="text-cyan-300 hover:text-teal-300 transition-colors duration-300 underline decoration-2">
               Facebook Event
            </a>
          </div>
        </div>

        <div class="pt-6 md:pt-8 lg:pt-4 slide-up max-w-4xl mx-auto">
          <div class="space-y-6 md:space-y-8">
            <div class="bg-gray-800/30 backdrop-blur-sm rounded-2xl p-6 md:p-8 border border-gray-700/50">
              <div class="space-y-6 text-center">
                <div class="inline-block bg-gray-700/50 text-gray-300 px-6 py-3 rounded-full border border-gray-600">
                  <p class="text-lg md:text-xl font-semibold font-oswald uppercase">
                    Event Completed - January 11, 2025
                  </p>
                </div>
                <p class="text-base md:text-lg lg:text-xl text-gray-300 leading-relaxed">
                  Our first-ever Golang Meetup was a huge success! We brought together passionate Gophers from across Bangladesh to connect, learn, and celebrate with fellow developers and industry leaders. Thank you to all our speakers, sponsors, organizers, and attendees who made this event memorable!
                </p>
                <div class="bg-cyan-500/10 backdrop-blur-sm rounded-xl p-6 border border-cyan-500/20">
                  <p class="text-cyan-300 text-base md:text-lg font-semibold mb-2">
                    🎉 Next Meetup Coming in 2026!
                  </p>
                  <p class="text-gray-300 text-sm md:text-base">
                    We're planning our next big meetup! Join our <a href="https://discord.gg/gophersbd" class="text-cyan-400 hover:text-cyan-300 underline">Discord</a> or <a href="https://www.facebook.com/groups/8890201047753940" class="text-cyan-400 hover:text-cyan-300 underline">Facebook group</a> to stay updated.
                  </p>
                </div>
              </div>
            </div>            
          </div>
        </div>
      </section>

      <Speakers />
      <Oranizers />
      <Sponsors />

      <footer class="text-center text-gray-400 pt-6 md:pt-8 lg:pt-10 border-t border-gray-700 slide-up">
        <p class="text-sm md:text-base font-light">© 2025 Gophers Bangladesh | All rights reserved.</p>
      </footer>
    </div>
  </div>
</Layout>

<style>
  /* Container */
  .container-custom {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
  }

  /* Background pattern */
  .pattern-bg {
    background-size: 20px 20px;
    background-image: radial-gradient(circle, currentColor 1px, transparent 1px);
    opacity: 0.05;
  }

  /* Info cards */
  .info-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    background-color: rgba(17, 24, 39, 0.5);
    backdrop-filter: blur(8px);
    border-radius: 1rem;
    border: 1px solid rgba(55, 65, 81, 0.5);
  }

  /* Animations */
  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
    100% { transform: translateY(0px); }
  }

  @keyframes gradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  .animate-gradient {
    background-size: 200% auto;
    animation: gradient 4s linear infinite;
  }

  #main-content {
    animation: fadeIn 0.8s ease-out forwards;
  }

  .slide-up {
    opacity: 0;
    transform: translateY(20px);
    animation: slideUp 0.8s ease-out forwards;
  }

  .hover\:scale-102:hover {
    transform: scale(1.02);
  }
  
  /* Gradient animation for cards */
  @keyframes borderGlow {
    0%, 100% { border-color: rgba(34, 211, 238, 0.3); }
    50% { border-color: rgba(45, 212, 191, 0.3); }
  }
  
  .animate-border-glow {
    animation: borderGlow 2s ease-in-out infinite;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Custom responsive breakpoints */
  @media (max-width: 640px) {
    .info-card {
      width: 100%;
      margin: 0 auto;
    }
  }

  @media (min-width: 1536px) {
    .container-custom {
      max-width: 1536px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const elements = document.querySelectorAll('.slide-up');
    elements.forEach((el, index) => {
      el.style.setProperty('--delay', index);
      el.style.animationDelay = `${index * 0.2}s`;
    });
  });
</script>

