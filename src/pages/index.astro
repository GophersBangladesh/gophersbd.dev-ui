                  <div class="flex items-center gap-2">
                    <span class="text-gray-400 text-xl">📅</span>
                    <span>11th January, 2025</span>
              </div>
                  <div class="hidden md:block w-px h-6 bg-gray-600"></div>
                  <div class="flex items-center gap-2">
                    <span class="text-gray-400 text-xl">📍</span>
                    <span>The Attention Network</span>
              </div>
            </div>
            
                <p class="text-gray-400 text-base md:text-lg max-w-2xl mx-auto">
                  Our first-ever Golang Meetup was a success! Check out the speakers, organizers, and highlights from this amazing event.
                </p>
                
                <div class="flex items-center justify-center gap-3 text-gray-300 font-semibold text-lg md:text-xl group-hover:gap-4 transition-all">
                  <span>View Event Recap</span>
                  <svg class="w-6 h-6 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                  </svg>
                </div>
              </div>
            </div>            
          </a>
        </div>

        <!-- Future Event Teaser -->
        <div class="slide-up max-w-2xl w-full text-center">
          <div class="bg-gradient-to-br from-cyan-500/10 to-teal-500/10 backdrop-blur-sm rounded-2xl p-6 md:p-8 border border-cyan-500/20">
            <h3 class="text-xl md:text-2xl font-bold text-cyan-300 mb-3 font-oswald uppercase">🎉 Next Meetup Coming Soon!</h3>
            <p class="text-gray-300 text-base md:text-lg">
              We're planning our next meetup for 2026! Stay tuned for updates. Join our Discord and Facebook community to stay in the loop.
            </p>
          </div>
        </div>
      </section>

      <!-- About Section -->
      <section class="py-16 md:py-24 space-y-8 md:space-y-12 slide-up">
        <div class="text-center space-y-4">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-100 font-oswald uppercase">
            About Us
          </h2>
          <div class="w-20 md:w-24 lg:w-32 h-1 bg-gradient-to-r from-cyan-500 to-teal-400 mx-auto"></div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          <div class="bg-gray-800/30 backdrop-blur-sm rounded-2xl p-6 md:p-8 border border-gray-700/50 hover:border-cyan-500/30 transition-all duration-300">
            <div class="text-4xl mb-4">🤝</div>
            <h3 class="text-xl md:text-2xl font-bold text-cyan-300 mb-3 font-oswald uppercase">Local Hangouts</h3>
            <p class="text-gray-300 leading-relaxed">
              Regular meetups and hangouts where Gophers connect, share knowledge, and build friendships in person.
            </p>
          </div>
          
          <div class="bg-gray-800/30 backdrop-blur-sm rounded-2xl p-6 md:p-8 border border-gray-700/50 hover:border-cyan-500/30 transition-all duration-300">
            <div class="text-4xl mb-4">💬</div>
            <h3 class="text-xl md:text-2xl font-bold text-cyan-300 mb-3 font-oswald uppercase">Online Community</h3>
            <p class="text-gray-300 leading-relaxed">
              Active Discord server and Facebook group with hundreds of passionate Go developers helping each other daily.
            </p>
          </div>
          
          <div class="bg-gray-800/30 backdrop-blur-sm rounded-2xl p-6 md:p-8 border border-gray-700/50 hover:border-cyan-500/30 transition-all duration-300">
            <div class="text-4xl mb-4">🔓</div>
            <h3 class="text-xl md:text-2xl font-bold text-cyan-300 mb-3 font-oswald uppercase">Open Source</h3>
            <p class="text-gray-300 leading-relaxed">
              Contribute to open source Go projects on our GitHub organization and collaborate with fellow developers.
            </p>
          </div>
        </div>
      </section>

      <!-- Join Community Section -->
      <section class="py-16 md:py-24 slide-up">
        <div class="bg-gradient-to-br from-indigo-500/10 to-purple-500/10 backdrop-blur-sm rounded-3xl p-8 md:p-12 lg:p-16 border border-indigo-500/20 text-center space-y-6 max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-100 font-oswald uppercase">
            Join Our Community
          </h2>
          <p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto">
            Connect with fellow Gophers on Discord, Facebook, and GitHub. Share knowledge, collaborate on open source, and join local hangouts.
