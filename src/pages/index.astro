            </svg>
            GitHub
          </a>
        </div>

        <!-- Past Event Card -->
        <div class="slide-up max-w-4xl w-full">
          <a href="/events/golang-meetup-2025" class="block group">
            <div class="relative bg-gradient-to-br from-gray-700/10 to-gray-800/10 backdrop-blur-sm rounded-3xl p-8 md:p-12 border-2 border-gray-600/30 hover:border-gray-500/50 transition-all duration-300 hover:scale-105 hover:shadow-2xl hover:shadow-gray-500/20">
              <div class="relative space-y-6">
                <div class="flex items-center justify-center gap-3">
                  <img src="images/line.png" alt="Golang Logo" class="w-16 h-8 md:w-20 md:h-10 object-contain" />
                  <span class="inline-block bg-gray-500/20 text-gray-300 text-xs md:text-sm font-semibold px-4 py-1.5 rounded-full border border-gray-500/30 uppercase tracking-wider">
                    Past Event - January 2025
                  </span>
              </div>
                
                <h2 class="font-oswald uppercase font-bold text-3xl md:text-5xl lg:text-6xl bg-gradient-to-r from-gray-300 to-gray-400 bg-clip-text text-transparent">
                  Golang Meetup 2025
                </h2>
                
