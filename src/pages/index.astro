---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Gophers Bangladesh — Go Programming Community">
  <div class="bg-gradient-to-b from-gray-900 via-gray-800 to-gray-900 text-gray-200 min-h-screen relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-gray-800/10 to-gray-900/10 pattern-bg"></div>
    
    <div class="container-custom px-4 py-6 md:py-12 lg:py-16 mx-auto relative">
      <!-- Hero Section -->
      <section class="min-h-[80vh] flex flex-col items-center justify-center text-center space-y-8 md:space-y-12">
        <div class="space-y-6 slide-up">
          <div class="flex justify-center items-center">
            <img src="favicon.png" alt="Gophers Bangladesh Logo" class="w-24 h-24 md:w-32 md:h-32 lg:w-40 lg:h-40 object-contain animate-float" />
          </div>
          
